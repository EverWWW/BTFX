<UserControl
    x:Class="BTFX.Views.Settings.DeviceConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BTFX.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1400"
    FontFamily="{StaticResource AppFont}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SettingsSectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="24,22,24,24" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SettingsSectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="Height" Value="33" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#403B5B" />
            <Setter Property="LineHeight" Value="33" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsLabelTextStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="120" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="#666666" />
        </Style>

        <Style x:Key="SettingsInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="360" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="#403B5B" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#403B5B" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#B0B0B0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Background" Value="#403B5B" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="SettingsSecondaryButtonStyle"
            BasedOn="{StaticResource SettingsPrimaryButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#F0F4F9" />
            <Setter Property="Foreground" Value="#403B5B" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid MaxWidth="1640" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="220" />
                <RowDefinition Height="20" />
                <RowDefinition Height="220" />
            </Grid.RowDefinitions>

            <Border Grid.Row="1" Style="{StaticResource SettingsSectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="4"
                                Height="16"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Background="#E4004A"
                                CornerRadius="2" />
                            <TextBlock Style="{StaticResource SettingsSectionTitleTextStyle}" Text="{DynamicResource DeviceIdSettings}" />
                        </StackPanel>

                        <Button
                            Width="170"
                            Height="42"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding OpenDahengCameraTestDialogCommand}"
                            Content="{DynamicResource DahengCameraTest.Button}"
                            FontSize="16"
                            Style="{StaticResource SettingsSecondaryButtonStyle}"
                            Visibility="Collapsed" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,26,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="390" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="390" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource SettingsLabelTextStyle}" Text="{DynamicResource SideCameraId}" />
                        <TextBox
                            Grid.Column="1"
                            Text="{Binding SideCameraName, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource SettingsInputTextBoxStyle}" />

                        <TextBlock
                            Grid.Column="3"
                            Style="{StaticResource SettingsLabelTextStyle}"
                            Text="{DynamicResource FrontCameraId}" />
                        <TextBox
                            Grid.Column="4"
                            Text="{Binding FrontCameraName, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource SettingsInputTextBoxStyle}" />

                        <Button
                            Grid.Column="5"
                            Command="{Binding SaveDeviceConfigCommand}"
                            Content="{DynamicResource Save}"
                            Style="{StaticResource SettingsPrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource SettingsSectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="4"
                            Height="16"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="#E4004A"
                            CornerRadius="2" />
                        <TextBlock Style="{StaticResource SettingsSectionTitleTextStyle}" Text="{DynamicResource DeviceParameterSettings}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,26,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Width="Auto"
                            VerticalAlignment="Center"
                            Style="{StaticResource SettingsLabelTextStyle}"
                            Text="{DynamicResource ConfigSoftware}" />
                        <TextBox
                            Grid.Column="2"
                            MinWidth="360"
                            Width="Auto"
                            Style="{StaticResource SettingsInputTextBoxStyle}"
                            Text="{Binding ExternalCameraConfigToolPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="4"
                            Command="{Binding SelectExternalCameraConfigToolCommand}"
                            Content="{DynamicResource Select}"
                            Style="{StaticResource SettingsSecondaryButtonStyle}" />
                        <Button
                            Grid.Column="6"
                            Command="{Binding OpenExternalCameraConfigToolCommand}"
                            Content="{DynamicResource Open}"
                            Style="{StaticResource SettingsPrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
