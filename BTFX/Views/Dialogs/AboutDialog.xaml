<UserControl
    x:Class="BTFX.Views.Dialogs.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:BTFX.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="620"
    Height="560"
    d:DesignHeight="560"
    d:DesignWidth="620"
    FontFamily="{StaticResource AppFont}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="120" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="18,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="AboutPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="160" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Background" Value="#403B5B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.78" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="#FFFFFF" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="88" />
                <RowDefinition Height="*" />
                <RowDefinition Height="92" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#F3F8FC"
                CornerRadius="8,8,0,0">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Medium"
                        Foreground="#333333"
                        Text="关于我们" />
                    <Button
                        Width="56"
                        Height="56"
                        Margin="0,0,24,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        Cursor="Hand">
                        <materialDesign:PackIcon
                            Width="28"
                            Height="28"
                            Foreground="#403B5B"
                            Kind="Close" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="48,34,48,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="92" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#F3F8FC"
                        CornerRadius="36">
                        <materialDesign:PackIcon
                            Width="42"
                            Height="42"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#403B5B"
                            Kind="Walk" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#333333"
                            Text="{x:Static common:Constants.APP_DISPLAY_NAME}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="16"
                            Foreground="#666666"
                            Text="{x:Static common:Constants.APP_DISPLAY_NAME_EN}" />
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="1"
                    Padding="24,20"
                    Background="#FAFAFA"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoLabelStyle}" Text="软件版本" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{x:Static common:Constants.VERSION_FULL}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource InfoLabelStyle}" Text="发布版本" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{x:Static common:Constants.VERSION_DISPLAY}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoLabelStyle}" Text="内部版本" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{x:Static common:Constants.VERSION_INTERNAL}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource InfoLabelStyle}" Text="协议版本" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValueStyle}" Text="{x:Static common:Constants.PROTOCOL_VERSION}" />
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="#E8EDF3" />

                <StackPanel
                    Grid.Row="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Foreground="#666666"
                        Text="{x:Static common:Constants.ALLRIGHTSRESERVED}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Foreground="#666666"
                        Text="{DynamicResource AllRightsReserved}" />
                </StackPanel>
            </Grid>

            <Button
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                Content="{DynamicResource Close}"
                Style="{StaticResource AboutPrimaryButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
