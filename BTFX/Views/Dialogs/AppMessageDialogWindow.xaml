<Window
    x:Class="BTFX.Views.Dialogs.AppMessageDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="720"
    Height="520"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{StaticResource AppFont}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Manual"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <Style x:Key="DialogButtonBaseStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Background" Value="#403B5B" />
            <Setter Property="BorderBrush" Value="#403B5B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#514A70" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#514A70" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#332E4C" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#332E4C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="DialogSecondaryButtonStyle"
            BasedOn="{StaticResource DialogButtonBaseStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#403B5B" />
            <Setter Property="Foreground" Value="#403B5B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F1EFF7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E4E0EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CloseBackground"
                            Background="{TemplateBinding Background}"
                            CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBackground" Property="Background" Value="#F1EFF7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBackground" Property="Background" Value="#E4E0EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Overlay" Background="#66000000">
        <Border
            x:Name="DialogCard"
            Width="680"
            MaxHeight="560"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#FFFFFF"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="18"
                    Opacity="0.18"
                    ShadowDepth="4" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="84" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="112" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="72,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="30"
                    FontWeight="Medium"
                    Foreground="#222222"
                    Text="{Binding DialogTitle}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />

                <Button
                    Width="48"
                    Height="48"
                    Margin="0,18,18,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    Click="CloseButton_OnClick"
                    Style="{StaticResource DialogCloseButtonStyle}">
                    <materialDesign:PackIcon
                        Width="28"
                        Height="28"
                        Foreground="#403B5B"
                        Kind="Close" />
                </Button>

                <Border
                    Grid.Row="1"
                    Width="104"
                    Height="104"
                    Margin="0,12,0,20"
                    HorizontalAlignment="Center"
                    Background="#F3F6FA"
                    CornerRadius="52">
                    <materialDesign:PackIcon
                        x:Name="DialogIcon"
                        Width="58"
                        Height="58"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#403B5B" />
                </Border>

                <ScrollViewer
                    Grid.Row="2"
                    MaxHeight="190"
                    Margin="50,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        FontSize="22"
                        FontWeight="Normal"
                        Foreground="#333333"
                        LineHeight="34"
                        Text="{Binding DialogMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </ScrollViewer>

                <StackPanel
                    Grid.Row="3"
                    Margin="0,24,0,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="SecondaryButton"
                        Margin="0,0,20,0"
                        Click="SecondaryButton_OnClick"
                        Style="{StaticResource DialogSecondaryButtonStyle}" />
                    <Button
                        x:Name="PrimaryButton"
                        Click="PrimaryButton_OnClick"
                        IsDefault="True"
                        Style="{StaticResource DialogButtonBaseStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
