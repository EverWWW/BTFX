<UserControl
    x:Class="BTFX.Views.Dialogs.UserEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:BTFX.Behaviors"
    xmlns:common="clr-namespace:BTFX.Common"
    xmlns:converters="clr-namespace:BTFX.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BTFX.ViewModels"
    Width="1180"
    Height="760"
    d:DataContext="{d:DesignInstance Type=vm:UserEditViewModel}"
    d:DesignHeight="760"
    d:DesignWidth="1180"
    FontFamily="{StaticResource AppFont}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="DialogFormLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="120" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="DialogInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E1E1E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E1E1E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Height" Value="48" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="10">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F0F4F9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="64" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E1E1E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DialogComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="True">
                            <ToggleButton
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                ClickMode="Press"
                                Cursor="Hand"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="OuterBorder"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="16"
                                            SnapsToDevicePixels="True">
                                            <Path
                                                Width="12"
                                                Height="7"
                                                Margin="0,0,18,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Data="M0,0 L6,6 L12,0"
                                                Fill="Transparent"
                                                Stroke="#999999"
                                                StrokeThickness="1.5" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#B0B0B0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter
                                Margin="18,0,40,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                IsHitTestVisible="False" />
                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Fade">
                                <Border
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,6,0,0"
                                    Padding="8"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E2E2"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                    <ScrollViewer MaxHeight="180" CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="180" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Background" Value="#403B5B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#514A70" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#342F4E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D1D1D1" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="DialogSecondaryButtonStyle"
            BasedOn="{StaticResource DialogPrimaryButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#403B5B" />
            <Setter Property="Foreground" Value="#403B5B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F4F3F8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8E6EF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#D1D1D1" />
                                <Setter Property="Foreground" Value="#999999" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#FFFFFF" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="88" />
                <RowDefinition Height="*" />
                <RowDefinition Height="116" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#F3F8FC"
                CornerRadius="8,8,0,0">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Medium"
                        Foreground="#333333"
                        Text="{Binding DialogTitle}" />
                    <Button
                        Width="56"
                        Height="56"
                        Margin="0,0,24,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CancelCommand}"
                        Cursor="Hand">
                        <materialDesign:PackIcon
                            Width="28"
                            Height="28"
                            Foreground="#403B5B"
                            Kind="Close" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="88,54,88,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="86" />
                    <RowDefinition Height="86" />
                    <RowDefinition Height="86" />
                    <RowDefinition Height="86" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogFormLabelStyle}">
                    <Run Foreground="#F23030" Text="* " />
                    <Run Text="登录账号" />
                </TextBlock>
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    IsEnabled="{Binding IsNewUser}"
                    MaxLength="{x:Static common:Constants.USERNAME_MAX_LENGTH}"
                    Style="{StaticResource DialogInputTextBoxStyle}"
                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource DialogFormLabelStyle}">
                    <Run Foreground="#F23030" Text="* " />
                    <Run Text="角色" />
                </TextBlock>
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="4"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding RoleOptions}"
                    SelectedItem="{Binding SelectedRole}"
                    Style="{StaticResource DialogComboBoxStyle}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogFormLabelStyle}">
                    <Run Foreground="#F23030" Text="* " />
                    <Run Text="用户姓名" />
                </TextBlock>
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    MaxLength="{x:Static common:Constants.NAME_MAX_LENGTH}"
                    Style="{StaticResource DialogInputTextBoxStyle}"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource DialogFormLabelStyle}" Text="科室" />
                <ComboBox
                    Grid.Row="1"
                    Grid.Column="4"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Departments}"
                    SelectedItem="{Binding SelectedDepartment}"
                    Style="{StaticResource DialogComboBoxStyle}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DialogFormLabelStyle}" Text="电话" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    MaxLength="{x:Static common:Constants.PHONE_MAX_LENGTH}"
                    Style="{StaticResource DialogInputTextBoxStyle}"
                    Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Behaviors>
                        <behaviors:NumericTextBoxBehavior AllowDecimal="False" />
                    </i:Interaction.Behaviors>
                </TextBox>

                <StackPanel
                    Grid.Row="2"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding ShowStatusToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ToggleButton
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsEnabled}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    <TextBlock
                        Margin="18,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="22"
                        Foreground="#666666"
                        Text="启用账号" />
                </StackPanel>

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Style="{StaticResource DialogFormLabelStyle}"
                    Visibility="{Binding IsNewUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Foreground="#F23030" Text="* " />
                    <Run Text="登录密码" />
                </TextBlock>
                <PasswordBox
                    x:Name="PasswordBox"
                    Grid.Row="3"
                    Grid.Column="1"
                    MaxLength="{x:Static common:Constants.PASSWORD_MAX_LENGTH}"
                    PasswordChanged="PasswordBox_PasswordChanged"
                    Style="{StaticResource DialogPasswordBoxStyle}"
                    Visibility="{Binding IsNewUser, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="3"
                    Style="{StaticResource DialogFormLabelStyle}"
                    Visibility="{Binding IsNewUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Foreground="#F23030" Text="* " />
                    <Run Text="确认密码" />
                </TextBlock>
                <PasswordBox
                    x:Name="ConfirmPasswordBox"
                    Grid.Row="3"
                    Grid.Column="4"
                    MaxLength="{x:Static common:Constants.PASSWORD_MAX_LENGTH}"
                    PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                    Style="{StaticResource DialogPasswordBoxStyle}"
                    Visibility="{Binding IsNewUser, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Grid.ColumnSpan="4"
                    Margin="0,10,0,0"
                    FontSize="18"
                    Foreground="#999999"
                    LineHeight="30"
                    Text="密码由纯数字组成，登录密码需与确认密码一致。"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsNewUser, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Grid.ColumnSpan="4"
                    Margin="0,50,0,0"
                    FontSize="20"
                    FontWeight="Medium"
                    Foreground="#F23030"
                    Text="{Binding ValidationError}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,80,0"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    Style="{StaticResource DialogSecondaryButtonStyle}" />
                <Button
                    Command="{Binding SaveCommand}"
                    Content="确认"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource DialogPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
