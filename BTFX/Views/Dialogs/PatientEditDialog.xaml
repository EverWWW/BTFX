<UserControl
    x:Class="BTFX.Views.Dialogs.PatientEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:BTFX.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="1360"
    Height="740"
    d:DesignHeight="740"
    d:DesignWidth="1360"
    FontFamily="{StaticResource AppFont}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="PatientLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="PatientInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E1E1E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="PatientMemoInputStyle"
            BasedOn="{StaticResource PatientInputStyle}"
            TargetType="TextBox">
            <Setter Property="Height" Value="54" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <Style x:Key="PatientComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="10">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F0F4F9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PatientComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E1E1E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PatientComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="True">
                            <ToggleButton
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                ClickMode="Press"
                                Cursor="Hand"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="OuterBorder"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="16"
                                            SnapsToDevicePixels="True">
                                            <Path
                                                Width="12"
                                                Height="7"
                                                Margin="0,0,18,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Data="M0,0 L6,6 L12,0"
                                                Fill="Transparent"
                                                Stroke="#999999"
                                                StrokeThickness="1.5" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#B0B0B0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter
                                Margin="18,0,40,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                IsHitTestVisible="False" />
                            <Popup
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Fade">
                                <Border
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,6,0,0"
                                    Padding="8"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E2E2"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                    <ScrollViewer MaxHeight="180" CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PatientDateButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E1E1E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PatientPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="160" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Background" Value="#403B5B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#342F4C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2B2740" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D1D1D1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="PatientSecondaryButtonStyle"
            BasedOn="{StaticResource PatientPrimaryButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#403B5B" />
            <Setter Property="Foreground" Value="#403B5B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F4F2FA" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#403B5B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E9E5F2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#FFFFFF" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="88" />
                <RowDefinition Height="*" />
                <RowDefinition Height="86" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#F3F8FC"
                CornerRadius="8,8,0,0">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Medium"
                        Foreground="#333333"
                        Text="{Binding DialogTitle}" />
                    <Button
                        Width="56"
                        Height="56"
                        Margin="0,0,24,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CancelCommand}"
                        Cursor="Hand">
                        <materialDesign:PackIcon
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#403B5B"
                            Kind="Close" />
                    </Button>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Margin="28,28,28,0"
                Background="#FAFAFA"
                CornerRadius="8">
                <Grid Margin="56,34,56,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="68" />
                        <RowDefinition Height="68" />
                        <RowDefinition Height="68" />
                        <RowDefinition Height="68" />
                        <RowDefinition Height="68" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource PatientLabelStyle}">
                            <Run Foreground="#F23030" Text="* " />
                            <Run Text="姓名 " />
                        </TextBlock>
                        <TextBox
                            Grid.Column="1"
                            MaxLength="50"
                            Style="{StaticResource PatientInputStyle}"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Column="3"
                            Style="{StaticResource PatientLabelStyle}"
                            Text="性别" />
                        <ComboBox
                            Grid.Column="4"
                            SelectedIndex="{Binding Gender, Converter={StaticResource EnumToIndexConverter}}"
                            Style="{StaticResource PatientComboBoxStyle}">
                            <ComboBoxItem Content="{DynamicResource Male}" />
                            <ComboBoxItem Content="{DynamicResource Female}" />
                        </ComboBox>
                        <TextBlock
                            Grid.Column="6"
                            Style="{StaticResource PatientLabelStyle}"
                            Text="出生日期" />
                        <Grid Grid.Column="7">
                            <Button
                                x:Name="BirthDateButton"
                                Click="BirthDateButton_Click"
                                Style="{StaticResource PatientDateButtonStyle}">
                                <Grid>
                                    <TextBlock
                                        x:Name="BirthDateText"
                                        Margin="16,0,50,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource AppFont}"
                                        FontSize="22"
                                        Foreground="#333333"
                                        Text="请选择日期" />
                                    <materialDesign:PackIcon
                                        Width="22"
                                        Height="22"
                                        Margin="0,0,16,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="#999999"
                                        Kind="CalendarMonthOutline" />
                                </Grid>
                            </Button>
                            <Popup
                                x:Name="BirthDatePopup"
                                AllowsTransparency="True"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=BirthDateButton}"
                                PopupAnimation="Fade"
                                StaysOpen="False">
                                <Border
                                    Margin="0,6,0,0"
                                    Background="White"
                                    BorderBrush="#E5E5E5"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Calendar x:Name="BirthDateCalendar" SelectedDatesChanged="BirthDateCalendar_SelectedDatesChanged" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource PatientLabelStyle}"
                            Text="手机号" />
                        <TextBox
                            Grid.Column="1"
                            MaxLength="12"
                            Style="{StaticResource PatientInputStyle}"
                            Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}">
                            <i:Interaction.Behaviors>
                                <behaviors:NumericTextBoxBehavior AllowDecimal="False" />
                            </i:Interaction.Behaviors>
                        </TextBox>
                        <TextBlock Grid.Column="3" Style="{StaticResource PatientLabelStyle}">
                            <Run Foreground="#F23030" Text="* " />
                            <Run Text="身高" />
                        </TextBlock>
                        <Grid Grid.Column="4">
                            <TextBox
                                Padding="16,0,44,0"
                                MaxLength="6"
                                Style="{StaticResource PatientInputStyle}"
                                Text="{Binding Height, TargetNullValue='', UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=False, NotifyOnValidationError=False}">
                                <i:Interaction.Behaviors>
                                    <behaviors:NumericTextBoxBehavior AllowDecimal="True" MaxDecimalPlaces="2" />
                                </i:Interaction.Behaviors>
                            </TextBox>
                            <TextBlock
                                Margin="0,0,14,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="#999999"
                                Text="cm" />
                        </Grid>
                        <TextBlock
                            Grid.Column="6"
                            Style="{StaticResource PatientLabelStyle}"
                            Text="体重" />
                        <Grid Grid.Column="7">
                            <TextBox
                                Padding="16,0,44,0"
                                MaxLength="6"
                                Style="{StaticResource PatientInputStyle}"
                                Text="{Binding Weight, TargetNullValue='', UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=False, NotifyOnValidationError=False}">
                                <i:Interaction.Behaviors>
                                    <behaviors:NumericTextBoxBehavior AllowDecimal="True" MaxDecimalPlaces="2" />
                                </i:Interaction.Behaviors>
                            </TextBox>
                            <TextBlock
                                Margin="0,0,14,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="#999999"
                                Text="kg" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource PatientLabelStyle}"
                            Text="身份证号" />
                        <TextBox
                            Grid.Column="1"
                            MaxLength="20"
                            Style="{StaticResource PatientInputStyle}"
                            Text="{Binding IdNumber, UpdateSourceTrigger=PropertyChanged}">
                            <i:Interaction.Behaviors>
                                <behaviors:NumericTextBoxBehavior AllowDecimal="False" />
                            </i:Interaction.Behaviors>
                        </TextBox>
                        <TextBlock
                            Grid.Column="3"
                            Style="{StaticResource PatientLabelStyle}"
                            Text="就诊号" />
                        <TextBox
                            Grid.Column="4"
                            MaxLength="20"
                            Style="{StaticResource PatientInputStyle}"
                            Text="{Binding HospitalNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource PatientLabelStyle}"
                            Text="地址" />
                        <TextBox
                            Grid.Column="1"
                            MaxLength="500"
                            Style="{StaticResource PatientInputStyle}"
                            Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource PatientLabelStyle}"
                            Text="病史" />
                        <TextBox
                            Grid.Column="1"
                            MaxLength="500"
                            Style="{StaticResource PatientMemoInputStyle}"
                            Text="{Binding MedicalHistory, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource PatientLabelStyle}"
                            Text="备注" />
                        <TextBox
                            Grid.Column="1"
                            MaxLength="200"
                            Style="{StaticResource PatientMemoInputStyle}"
                            Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="6"
                        Margin="102,0,0,0"
                        FontSize="18"
                        Foreground="#F23030"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,80,0"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    Style="{StaticResource PatientSecondaryButtonStyle}" />
                <Button
                    Command="{Binding SaveCommand}"
                    Content="保存"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource PatientPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
