<UserControl
    x:Class="BTFX.Views.Dialogs.DahengCameraTestDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BTFX.ViewModels"
    Width="1180"
    Height="760"
    d:DataContext="{d:DesignInstance Type=vm:DahengCameraTestDialogViewModel}"
    FontFamily="{StaticResource AppFont}"
    Loaded="DahengCameraTestDialog_OnLoaded"
    Unloaded="DahengCameraTestDialog_OnUnloaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#403B5B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D1D1D1" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="DialogSecondaryButtonStyle"
            BasedOn="{StaticResource DialogButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#F0F4F9" />
            <Setter Property="Foreground" Value="#403B5B" />
        </Style>

        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#403B5B" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Border
        Background="#FFFFFF"
        CornerRadius="8"
        SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#F1F7FC"
                CornerRadius="8,8,0,0">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource AppFont}"
                        FontSize="24"
                        FontWeight="Medium"
                        Foreground="#2F2A4A"
                        Text="大恒相机测试" />
                    <Button
                        Width="42"
                        Height="42"
                        Margin="0,0,24,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        Cursor="Hand">
                        <materialDesign:PackIcon
                            Width="24"
                            Height="24"
                            Foreground="#403B5B"
                            Kind="Close" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <Border
                    Padding="20"
                    Background="#FAFAFA"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="设备" />
                            <ComboBox
                                Grid.Column="1"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding Devices}"
                                SelectedItem="{Binding SelectedDevice}"
                                Style="{StaticResource DialogComboBoxStyle}" />

                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="分辨率" />
                            <ComboBox
                                Grid.Column="4"
                                ItemsSource="{Binding ResolutionOptions}"
                                SelectedItem="{Binding SelectedResolution}"
                                Style="{StaticResource DialogComboBoxStyle}" />

                            <TextBlock
                                Grid.Column="6"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="帧率" />
                            <ComboBox
                                Grid.Column="7"
                                ItemsSource="{Binding FrameRateOptions}"
                                SelectedItem="{Binding SelectedFrameRate}"
                                Style="{StaticResource DialogComboBoxStyle}" />

                            <TextBlock
                                Grid.Column="9"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="#666666"
                                Text="时长" />
                            <ComboBox
                                Grid.Column="10"
                                ItemsSource="{Binding DurationOptions}"
                                SelectedItem="{Binding SelectedDurationSeconds}"
                                Style="{StaticResource DialogComboBoxStyle}" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox
                                VerticalAlignment="Center"
                                Content="加载 UserSet0"
                                FontSize="15"
                                Foreground="#403B5B"
                                IsChecked="{Binding AutoLoadUserSet0}" />

                            <WrapPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    Margin="0,0,12,0"
                                    Command="{Binding RefreshDevicesCommand}"
                                    Content="刷新设备"
                                    Style="{StaticResource DialogSecondaryButtonStyle}" />
                                <Button
                                    Margin="0,0,12,0"
                                    Command="{Binding OpenDeviceCommand}"
                                    Content="打开设备"
                                    Style="{StaticResource DialogButtonStyle}" />
                                <Button
                                    Margin="0,0,12,0"
                                    Command="{Binding StartPreviewCommand}"
                                    Content="开始预览"
                                    Style="{StaticResource DialogButtonStyle}" />
                                <Button
                                    Margin="0,0,12,0"
                                    Command="{Binding StopPreviewCommand}"
                                    Content="停止预览"
                                    Style="{StaticResource DialogSecondaryButtonStyle}" />
                                <Button
                                    Margin="0,0,12,0"
                                    Command="{Binding StartRecordingCommand}"
                                    Content="开始录制"
                                    Style="{StaticResource DialogButtonStyle}" />
                                <Button
                                    Command="{Binding StopRecordingCommand}"
                                    Content="停止录制"
                                    Style="{StaticResource DialogSecondaryButtonStyle}" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Background="#111111"
                        ClipToBounds="True"
                        CornerRadius="8">
                        <Grid>
                            <Image
                                Stretch="Uniform"
                                Source="{Binding PreviewImage}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="#DDDDDD"
                                Text="未开始预览">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Padding="20"
                        Background="#FAFAFA"
                        CornerRadius="8">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                                <Border
                                    Width="4"
                                    Height="16"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="#E4004A"
                                    CornerRadius="2" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="Medium"
                                    Foreground="#403B5B"
                                    Text="设备信息" />
                            </StackPanel>

                            <TextBlock
                                FontSize="15"
                                Foreground="#666666"
                                Text="{Binding StatusText}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,20,0,6"
                                FontSize="14"
                                Foreground="#999999"
                                Text="SN" />
                            <TextBlock
                                FontSize="16"
                                Foreground="#403B5B"
                                Text="{Binding SelectedDevice.SerialNumber, TargetNullValue=--}" />

                            <TextBlock
                                Margin="0,16,0,6"
                                FontSize="14"
                                Foreground="#999999"
                                Text="UserID" />
                            <TextBlock
                                FontSize="16"
                                Foreground="#403B5B"
                                Text="{Binding SelectedDevice.UserId, TargetNullValue=--}" />

                            <TextBlock
                                Margin="0,16,0,6"
                                FontSize="14"
                                Foreground="#999999"
                                Text="当前参数" />
                            <TextBlock
                                FontSize="14"
                                Foreground="#403B5B"
                                Text="{Binding CameraParameterSummary}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,16,0,6"
                                FontSize="14"
                                Foreground="#999999"
                                Text="录制状态" />
                            <TextBlock
                                FontSize="14"
                                Foreground="#403B5B"
                                Text="{Binding RecordingStatusText}"
                                TextWrapping="Wrap" />
                            <ProgressBar
                                Height="8"
                                Margin="0,10,0,0"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding RecordingProgress}" />
                            <TextBlock
                                Margin="0,10,0,0"
                                FontSize="12"
                                Foreground="#999999"
                                Text="{Binding LastRecordingPath}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding LastRecordingPath}" />

                            <Button
                                Width="228"
                                Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding CloseDeviceCommand}"
                                Content="关闭设备"
                                Style="{StaticResource DialogSecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Grid.Row="4"
                    Padding="16"
                    Background="#FAFAFA"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            FontSize="16"
                            FontWeight="Medium"
                            Foreground="#403B5B"
                            Text="运行日志" />
                        <ListBox
                            Grid.Row="1"
                            Margin="0,10,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="Consolas"
                            FontSize="12"
                            Foreground="#666666"
                            ItemsSource="{Binding LogLines}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
