<UserControl
    x:Class="BTFX.Views.Dialogs.DahengCameraTestDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BTFX.ViewModels"
    Width="1320"
    Height="820"
    d:DataContext="{d:DesignInstance Type=vm:DahengCameraTestDialogViewModel}"
    FontFamily="{StaticResource AppFont}"
    Loaded="DahengCameraTestDialog_OnLoaded"
    Unloaded="DahengCameraTestDialog_OnUnloaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#403B5B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D1D1D1" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="DialogSecondaryButtonStyle"
            BasedOn="{StaticResource DialogButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#F0F4F9" />
            <Setter Property="Foreground" Value="#403B5B" />
        </Style>

        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#403B5B" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#666666" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#403B5B" />
        </Style>
    </UserControl.Resources>

    <Border
        Background="#FFFFFF"
        CornerRadius="8"
        SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#F1F7FC"
                CornerRadius="8,8,0,0">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource AppFont}"
                        FontSize="24"
                        FontWeight="Medium"
                        Foreground="#2F2A4A"
                        Text="大恒双相机同步测试" />
                    <Button
                        Width="42"
                        Height="42"
                        Margin="0,0,24,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        Cursor="Hand">
                        <materialDesign:PackIcon
                            Width="24"
                            Height="24"
                            Foreground="#403B5B"
                            Kind="Close" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="158" />
                </Grid.RowDefinitions>

                <Border
                    Padding="18"
                    Background="#FAFAFA"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="侧面设备" />
                            <ComboBox
                                Grid.Column="1"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding Devices}"
                                SelectedItem="{Binding SideCamera.SelectedDevice}"
                                Style="{StaticResource DialogComboBoxStyle}" />

                            <TextBlock
                                Grid.Column="3"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="正面设备" />
                            <ComboBox
                                Grid.Column="4"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding Devices}"
                                SelectedItem="{Binding FrontCamera.SelectedDevice}"
                                Style="{StaticResource DialogComboBoxStyle}" />

                            <TextBlock
                                Grid.Column="6"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="分辨率" />
                            <ComboBox
                                Grid.Column="7"
                                ItemsSource="{Binding ResolutionOptions}"
                                SelectedItem="{Binding SelectedResolution}"
                                Style="{StaticResource DialogComboBoxStyle}" />

                            <TextBlock
                                Grid.Column="9"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="帧率" />
                            <ComboBox
                                Grid.Column="10"
                                ItemsSource="{Binding FrameRateOptions}"
                                SelectedItem="{Binding SelectedFrameRate}"
                                Style="{StaticResource DialogComboBoxStyle}" />

                            <TextBlock
                                Grid.Column="12"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="时长" />
                            <ComboBox
                                Grid.Column="13"
                                ItemsSource="{Binding DurationOptions}"
                                SelectedItem="{Binding SelectedDurationSeconds}"
                                Style="{StaticResource DialogComboBoxStyle}" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox
                                VerticalAlignment="Center"
                                Content="双相机模式"
                                FontSize="15"
                                Foreground="#403B5B"
                                IsChecked="{Binding IsDualMode}" />
                            <CheckBox
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Content="加载 UserSet0"
                                FontSize="15"
                                Foreground="#403B5B"
                                IsChecked="{Binding AutoLoadUserSet0}" />
                            <CheckBox
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Content="录制时预览"
                                FontSize="15"
                                Foreground="#403B5B"
                                IsChecked="{Binding PreviewDuringRecording}" />
                            <CheckBox
                                Grid.Column="6"
                                VerticalAlignment="Center"
                                Content="录制前重启采集"
                                FontSize="15"
                                Foreground="#403B5B"
                                IsChecked="{Binding RestartStreamBeforeRecording}" />

                            <WrapPanel
                                Grid.Column="7"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    Margin="0,0,10,0"
                                    Command="{Binding RefreshDevicesCommand}"
                                    Content="刷新设备"
                                    Style="{StaticResource DialogSecondaryButtonStyle}" />
                                <Button
                                    Margin="0,0,10,0"
                                    Command="{Binding OpenSelectedCamerasCommand}"
                                    Content="打开相机"
                                    Style="{StaticResource DialogButtonStyle}" />
                                <Button
                                    Margin="0,0,10,0"
                                    Command="{Binding StartPreviewCommand}"
                                    Content="开始预览"
                                    Style="{StaticResource DialogButtonStyle}" />
                                <Button
                                    Margin="0,0,10,0"
                                    Command="{Binding StopPreviewCommand}"
                                    Content="停止预览"
                                    Style="{StaticResource DialogSecondaryButtonStyle}" />
                                <Button
                                    Margin="0,0,10,0"
                                    Command="{Binding StartRecordingCommand}"
                                    Content="开始录制"
                                    Style="{StaticResource DialogButtonStyle}" />
                                <Button
                                    Margin="0,0,10,0"
                                    Command="{Binding StopRecordingCommand}"
                                    Content="停止录制"
                                    Style="{StaticResource DialogSecondaryButtonStyle}" />
                                <Button
                                    Command="{Binding CloseCamerasCommand}"
                                    Content="关闭相机"
                                    Style="{StaticResource DialogSecondaryButtonStyle}" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="14"
                        Background="#FAFAFA"
                        CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="4"
                                    Height="16"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="#E4004A"
                                    CornerRadius="2" />
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="侧面相机" />
                                <TextBlock
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#999999"
                                    Text="{Binding SideCamera.StatusText}" />
                            </StackPanel>

                            <Border
                                Grid.Row="2"
                                Background="#111111"
                                ClipToBounds="True"
                                CornerRadius="8">
                                <Grid>
                                    <Image
                                        RenderOptions.BitmapScalingMode="LowQuality"
                                        Source="{Binding SideCamera.PreviewImage}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="#DDDDDD"
                                        Text="未开始预览">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SideCamera.PreviewImage}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <StackPanel
                                Grid.Row="4"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <RadioButton
                                    Content="横向"
                                    GroupName="DahengSideOrientation"
                                    IsChecked="{Binding SideCamera.Orientation, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Landscape}"
                                    IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBooleanConverter}}" />
                                <RadioButton
                                    Margin="14,0,0,0"
                                    Content="纵向"
                                    GroupName="DahengSideOrientation"
                                    IsChecked="{Binding SideCamera.Orientation, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=PortraitClockwise}"
                                    IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBooleanConverter}}" />
                                <CheckBox
                                    Margin="16,0,0,0"
                                    Content="上下翻转"
                                    IsChecked="{Binding SideCamera.FlipVertical}"
                                    IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBooleanConverter}}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Row="6"
                                FontSize="12"
                                Foreground="#777777"
                                Text="{Binding SideCamera.ParameterSummary}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding SideCamera.ParameterSummary}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Padding="14"
                        Background="#FAFAFA"
                        CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="4"
                                    Height="16"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="#E4004A"
                                    CornerRadius="2" />
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="正面相机" />
                                <TextBlock
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#999999"
                                    Text="{Binding FrontCamera.StatusText}" />
                            </StackPanel>

                            <Border
                                Grid.Row="2"
                                Background="#111111"
                                ClipToBounds="True"
                                CornerRadius="8">
                                <Grid>
                                    <Image
                                        RenderOptions.BitmapScalingMode="LowQuality"
                                        Source="{Binding FrontCamera.PreviewImage}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="#DDDDDD"
                                        Text="未开始预览">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FrontCamera.PreviewImage}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <StackPanel
                                Grid.Row="4"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <RadioButton
                                    Content="横向"
                                    GroupName="DahengFrontOrientation"
                                    IsChecked="{Binding FrontCamera.Orientation, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Landscape}"
                                    IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBooleanConverter}}" />
                                <RadioButton
                                    Margin="14,0,0,0"
                                    Content="纵向"
                                    GroupName="DahengFrontOrientation"
                                    IsChecked="{Binding FrontCamera.Orientation, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=PortraitClockwise}"
                                    IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBooleanConverter}}" />
                                <CheckBox
                                    Margin="16,0,0,0"
                                    Content="上下翻转"
                                    IsChecked="{Binding FrontCamera.FlipVertical}"
                                    IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBooleanConverter}}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Row="6"
                                FontSize="12"
                                Foreground="#777777"
                                Text="{Binding FrontCamera.ParameterSummary}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding FrontCamera.ParameterSummary}" />
                        </Grid>
                    </Border>
                </Grid>

                <Border
                    Grid.Row="4"
                    Padding="14"
                    Background="#FAFAFA"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="4"
                                    Height="16"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="#E4004A"
                                    CornerRadius="2" />
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="录制状态" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="14"
                                Foreground="#403B5B"
                                Text="{Binding RecordingStatusText}"
                                TextWrapping="Wrap" />
                            <ProgressBar
                                Height="10"
                                Margin="0,12,0,0"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding RecordingProgress}" />
                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="12"
                                Foreground="#999999"
                                Text="{Binding LastRecordingPath}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding LastRecordingPath}" />
                        </StackPanel>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="运行日志" />
                            <ListBox
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="#666666"
                                ItemsSource="{Binding LogLines}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
