<UserControl
    x:Class="BTFX.Views.Dialogs.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:BTFX.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BTFX.Views.Dialogs"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="420"
    Height="480"
    d:DesignHeight="560"
    d:DesignWidth="420"
    FontFamily="{StaticResource AppFont}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ConfirmPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="180" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Background" Value="#403B5B" />
            <Setter Property="BorderBrush" Value="#403B5B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="ConfirmSecondaryButtonStyle"
            BasedOn="{StaticResource ConfirmPrimaryButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#403B5B" />
            <Setter Property="Foreground" Value="#403B5B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border
        Background="#FFFFFF"
        CornerRadius="8"
        SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="88" />
                <RowDefinition Height="158" />
                <RowDefinition Height="94" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button
                Width="56"
                Height="56"
                Margin="0,18,18,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                CommandParameter="{x:Static local:ConfirmDialog.FalseValue}"
                Cursor="Hand">
                <materialDesign:PackIcon
                    Width="28"
                    Height="28"
                    Foreground="#403B5B"
                    Kind="Close" />
            </Button>

            <Border
                Grid.Row="1"
                Width="132"
                Height="132"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F3F6FA"
                CornerRadius="66">
                <materialDesign:PackIcon
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="#403B5B"
                    Kind="{Binding IconKind}" />
            </Border>

            <TextBlock
                Grid.Row="2"
                MaxWidth="350"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{StaticResource AppFont}"
                FontSize="22"
                FontWeight="Medium"
                Foreground="#111111"
                Text="{Binding Message}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,20,0"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static local:ConfirmDialog.FalseValue}"
                    Content="{Binding CancelText}"
                    Style="{StaticResource ConfirmSecondaryButtonStyle}"
                    Visibility="{Binding IsCancelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Button
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static local:ConfirmDialog.TrueValue}"
                    Content="{Binding ConfirmText}"
                    Style="{StaticResource ConfirmPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
