<UserControl
    x:Class="BTFX.Views.Dialogs.DepartmentEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:BTFX.Common"
    xmlns:converters="clr-namespace:BTFX.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BTFX.ViewModels"
    Width="760"
    Height="620"
    d:DataContext="{d:DesignInstance Type=vm:DepartmentEditViewModel}"
    d:DesignHeight="620"
    d:DesignWidth="760"
    FontFamily="{StaticResource AppFont}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="DepartmentLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="132" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="DepartmentInputStyle" TargetType="TextBox">
            <Setter Property="Width" Value="360" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="24,0,0,0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E1E1E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="DepartmentMemoInputStyle"
            BasedOn="{StaticResource DepartmentInputStyle}"
            TargetType="TextBox">
            <Setter Property="Height" Value="96" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="DepartmentPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="180" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Background" Value="#403B5B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="DepartmentSecondaryButtonStyle"
            BasedOn="{StaticResource DepartmentPrimaryButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#403B5B" />
            <Setter Property="Foreground" Value="#403B5B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#FFFFFF" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="88" />
                <RowDefinition Height="*" />
                <RowDefinition Height="116" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#F3F8FC"
                CornerRadius="8,8,0,0">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Medium"
                        Foreground="#333333"
                        Text="{Binding Title}" />
                    <Button
                        Width="56"
                        Height="56"
                        Margin="0,0,24,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CancelCommand}"
                        Cursor="Hand">
                        <materialDesign:PackIcon
                            Width="28"
                            Height="28"
                            Foreground="#403B5B"
                            Kind="Close" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,58,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="86" />
                    <RowDefinition Height="86" />
                    <RowDefinition Height="118" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="540" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DepartmentLabelStyle}">
                        <Run Foreground="#F23030" Text="* " />
                        <Run Text="科室名称" />
                    </TextBlock>
                    <TextBox
                        MaxLength="{x:Static common:Constants.DEPARTMENT_NAME_MAX_LENGTH}"
                        Style="{StaticResource DepartmentInputStyle}"
                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DepartmentLabelStyle}" Text="科室代码" />
                    <TextBox
                        MaxLength="20"
                        Style="{StaticResource DepartmentInputStyle}"
                        Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Top"
                        Margin="0,12,0,0"
                        Style="{StaticResource DepartmentLabelStyle}"
                        Text="描述" />
                    <TextBox
                        MaxLength="200"
                        Style="{StaticResource DepartmentMemoInputStyle}"
                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="132,0,0,0"
                    FontSize="20"
                    FontWeight="Medium"
                    Foreground="#F23030"
                    Text="{Binding ValidationError}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,80,0"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource DepartmentSecondaryButtonStyle}" />
                <Button
                    Command="{Binding SaveCommand}"
                    Content="确认"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource DepartmentPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
