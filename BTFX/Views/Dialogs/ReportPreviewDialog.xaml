<UserControl
    x:Class="BTFX.Views.Dialogs.ReportPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BTFX.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ReportPreviewDialogViewModel}"
    Background="Transparent"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ReportOverlayMaskBrush" Color="#8C0D1B2A" />
        <SolidColorBrush x:Key="ReportDialogBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ReportCardBgBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="ReportWeakBgBrush" Color="#F8FAFD" />
        <SolidColorBrush x:Key="ReportBorderBrush" Color="#E5EAF0" />
        <SolidColorBrush x:Key="ReportCardBorderBrush" Color="#EEF1F5" />
        <SolidColorBrush x:Key="ReportPrimaryTextBrush" Color="#1F2D3D" />
        <SolidColorBrush x:Key="ReportBodyTextBrush" Color="#333333" />
        <SolidColorBrush x:Key="ReportSecondaryTextBrush" Color="#666666" />
        <SolidColorBrush x:Key="ReportWeakTextBrush" Color="#999999" />
        <SolidColorBrush x:Key="ReportPrimaryBrush" Color="#40385F" />
        <SolidColorBrush x:Key="ReportAccentBrush" Color="#E4004A" />
        <SolidColorBrush x:Key="ReportCheckBrush" Color="#E4004A" />
        <Style BasedOn="{StaticResource DialogLightScrollBarStyle}" TargetType="ScrollBar" />

        <Style x:Key="ReportTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ReportPrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ReportSectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ReportLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource ReportSecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ReportValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource ReportPrimaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ReportHintTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource ReportSecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ReportCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ReportCardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ReportCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="ReportSectionHeaderStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="ReportChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="#EEF2F7" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="ReportChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource ReportPrimaryBrush}" />
        </Style>

        <Style x:Key="ReportTextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF6FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCEEFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource ReportPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F7F5FB" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ReportPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEEAF7" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ReportPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D1D1D1" />
                    <Setter Property="BorderBrush" Value="#D1D1D1" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="ReportPrimaryButtonStyle"
            BasedOn="{StaticResource ReportSecondaryButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ReportPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ReportPrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#514A73" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#514A73" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#332D4F" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#332D4F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource ReportBodyTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Border
                                x:Name="CheckBoxBorder"
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                Background="#FFFFFF"
                                BorderBrush="#C8CED8"
                                BorderThickness="1.5"
                                CornerRadius="3">
                                <Path
                                    x:Name="CheckMark"
                                    Width="9"
                                    Height="7"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M1,3.5 L3.4,6 L8,1"
                                    Stroke="#FFFFFF"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.8"
                                    Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource ReportCheckBrush}" />
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource ReportCheckBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportToolbarTextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource ReportSecondaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding Content}"
                            TextDecorations="Underline" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ReportPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="#2F2A4A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Border Background="{StaticResource ReportOverlayMaskBrush}" />

        <Border
            Width="1440"
            Height="920"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource ReportDialogBgBrush}"
            BorderBrush="#E8EDF3"
            BorderThickness="1"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="28"
                    Direction="270"
                    Opacity="0.10"
                    ShadowDepth="0"
                    Color="#1F2A37" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="32,22,32,18"
                    BorderBrush="{StaticResource ReportBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Style="{StaticResource ReportTitleTextStyle}"
                            Text="{DynamicResource AnalysisDetail.ReportPreview.Title}" />

                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource ReportTextButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource AppFont}"
                                    FontSize="14"
                                    Foreground="{StaticResource ReportSecondaryTextBrush}"
                                    Text="{DynamicResource Close}" />
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource ReportSecondaryTextBrush}"
                                    Kind="Close" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Margin="32,18,32,0"
                    Padding="16,12"
                    Background="{StaticResource ReportWeakBgBrush}"
                    BorderBrush="{StaticResource ReportBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="1.8*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource ReportLabelTextStyle}"
                            Text="{DynamicResource Report.Field.Title}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource ReportValueTextStyle}"
                            Text="{Binding ReportTitle, Mode=OneWay, TargetNullValue=--}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource ReportLabelTextStyle}"
                            Text="{DynamicResource Report.Field.Number}" />
                        <TextBlock
                            Grid.Column="3"
                            Margin="0,0,24,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource ReportValueTextStyle}"
                            Text="{Binding ReportNumber, Mode=OneWay, TargetNullValue=--}" />
                        <TextBlock
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource ReportLabelTextStyle}"
                            Text="{DynamicResource Patient}" />
                        <TextBlock
                            Grid.Column="5"
                            VerticalAlignment="Center"
                            Style="{StaticResource ReportValueTextStyle}"
                            Text="{Binding PatientNameDisplay, Mode=OneWay, TargetNullValue=--}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource ReportLabelTextStyle}"
                            Text="{DynamicResource Report.Field.MeasurementType}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,24,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource ReportValueTextStyle}"
                            Text="{Binding MeasurementTypeDisplay, Mode=OneWay, TargetNullValue=--}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource ReportLabelTextStyle}"
                            Text="{DynamicResource Report.Field.AnalysisMode}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="3"
                            Margin="0,0,24,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource ReportValueTextStyle}"
                            Text="{Binding AnalysisModeDisplay, Mode=OneWay, TargetNullValue=--}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource ReportLabelTextStyle}"
                            Text="{DynamicResource Report.Field.MeasurementTime}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="5"
                            VerticalAlignment="Center"
                            Style="{StaticResource ReportValueTextStyle}"
                            Text="{Binding MeasurementDateDisplay, Mode=OneWay, TargetNullValue=--}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="32,20,32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ReportCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Style="{StaticResource ReportSectionHeaderStyle}">
                                <Border
                                    Width="4"
                                    Height="18"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource ReportAccentBrush}"
                                    CornerRadius="2" />
                                <TextBlock Style="{StaticResource ReportSectionTitleTextStyle}" Text="{DynamicResource AnalysisDetail.ReportConfig}" />
                            </StackPanel>

                            <ScrollViewer
                                Grid.Row="1"
                                CanContentScroll="False"
                                Style="{StaticResource DialogLightweightScrollViewerStyle}"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Margin="0,0,0,14" Style="{StaticResource ReportCardStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,12"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource ReportValueTextStyle}"
                                                Text="{DynamicResource AnalysisDetail.ReportConfig.IncludeSections}" />
                                            <CheckBox
                                                Content="{DynamicResource Report.Section.Spatiotemporal}"
                                                IsChecked="{Binding IncludeSpatiotemporalParameters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource ReportCheckBoxStyle}" />
                                            <CheckBox
                                                Content="{DynamicResource Report.Section.Kinematic}"
                                                IsChecked="{Binding IncludeKinematicParameters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource ReportCheckBoxStyle}" />
                                            <CheckBox
                                                Content="{DynamicResource Report.Section.TrunkPelvis}"
                                                IsChecked="{Binding IncludeTrunkPelvisParameters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding CanIncludeTrunkPelvisParameters}"
                                                Style="{StaticResource ReportCheckBoxStyle}" />
                                            <CheckBox
                                                Content="{DynamicResource Report.Section.Symmetry}"
                                                IsChecked="{Binding IncludeSymmetryAnalysis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource ReportCheckBoxStyle}" />
                                            <CheckBox
                                                Content="{DynamicResource Report.Section.SideParameters}"
                                                IsChecked="{Binding IncludeLeftRightParameters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource ReportCheckBoxStyle}" />
                                            <CheckBox
                                                Content="{DynamicResource Report.Section.Charts}"
                                                IsChecked="{Binding IncludeCurveCharts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource ReportCheckBoxStyle}" />

                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Style="{StaticResource ReportHintTextStyle}"
                                                Text="{DynamicResource ReportPreview.ConfigChangeHint}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,0,0,14" Style="{StaticResource ReportCardStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,12"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource ReportValueTextStyle}"
                                                Text="{DynamicResource ReportPreview.ExportFormat}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ComboBox
                                                    Grid.Column="0"
                                                    Height="42"
                                                    Padding="12,0"
                                                    VerticalContentAlignment="Center"
                                                    FontFamily="{StaticResource AppFont}"
                                                    FontSize="14"
                                                    ItemsSource="{Binding ExportFormats}"
                                                    SelectedItem="{Binding SelectedExportFormat, Mode=TwoWay}" />

                                                <Button
                                                    Grid.Column="2"
                                                    Width="112"
                                                    Command="{Binding ExportReportCommand}"
                                                    Content="{DynamicResource Report.ExportReport}"
                                                    Style="{StaticResource ReportPrimaryButtonStyle}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ReportCardStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,12"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource ReportValueTextStyle}"
                                                Text="{DynamicResource ReportPreview.PrintOperation}" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button
                                                    Width="110"
                                                    Margin="0,0,10,0"
                                                    Command="{Binding PrintCommand}"
                                                    Content="{DynamicResource Print}"
                                                    Style="{StaticResource ReportSecondaryButtonStyle}" />
                                            </StackPanel>

                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource ReportCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Style="{StaticResource ReportSectionHeaderStyle}">
                                <Border
                                    Width="4"
                                    Height="18"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource ReportAccentBrush}"
                                    CornerRadius="2" />
                                <TextBlock Style="{StaticResource ReportSectionTitleTextStyle}" Text="{DynamicResource ReportPreview.DocumentPreview}" />
                            </StackPanel>

                            <Border
                                Grid.Row="2"
                                Height="38"
                                Padding="12,0"
                                Background="{StaticResource ReportWeakBgBrush}"
                                BorderBrush="{StaticResource ReportBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button
                                            Click="PreviousPageButton_OnClick"
                                            Content="{DynamicResource PreviousPage}"
                                            Style="{StaticResource ReportToolbarTextButtonStyle}" />
                                        <Button
                                            Margin="16,0,0,0"
                                            Click="NextPageButton_OnClick"
                                            Content="{DynamicResource NextPage}"
                                            Style="{StaticResource ReportToolbarTextButtonStyle}" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="PageIndicatorTextBlock"
                                        Grid.Column="1"
                                        Margin="24,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ReportHintTextStyle}"
                                        Text="1 / 1"
                                        Visibility="Collapsed" />
                                    <StackPanel
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button
                                            Click="ZoomOutButton_OnClick"
                                            Content="{DynamicResource ReportPreview.ZoomOut}"
                                            Style="{StaticResource ReportToolbarTextButtonStyle}" />
                                        <TextBlock
                                            x:Name="ZoomPercentTextBlock"
                                            Margin="18,0,18,0"
                                            Style="{StaticResource ReportHintTextStyle}"
                                            Text="100%" />
                                        <Button
                                            Click="ZoomInButton_OnClick"
                                            Content="{DynamicResource ReportPreview.ZoomIn}"
                                            Style="{StaticResource ReportToolbarTextButtonStyle}" />
                                        <Button
                                            Margin="18,0,0,0"
                                            Click="FitWidthButton_OnClick"
                                            Content="{DynamicResource ReportPreview.FitWidth}"
                                            Style="{StaticResource ReportToolbarTextButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="4"
                                Padding="0"
                                Background="{StaticResource ReportCardBgBrush}"
                                BorderBrush="#DDE5EF"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Border
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource ReportBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="12"
                                            Direction="270"
                                            Opacity="0.10"
                                            ShadowDepth="0"
                                            Color="#1F2A37" />
                                    </Border.Effect>
                                    <FlowDocumentScrollViewer
                                        x:Name="ReportDocumentViewer"
                                        Margin="12"
                                        Document="{Binding PreviewDocument}"
                                        IsToolBarVisible="False"
                                        MaxZoom="220"
                                        MinZoom="50"
                                        VerticalScrollBarVisibility="Auto"
                                        Zoom="100" />
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border
                    Grid.Row="3"
                    Padding="32,18,32,24"
                    Background="#FFFFFF">
                    <Grid>
                        <Button
                            HorizontalAlignment="Left"
                            Command="{Binding BackToConfigCommand}"
                            Content="{DynamicResource AnalysisDetail.ReportPreview.BackToConfig}"
                            Style="{StaticResource ReportSecondaryButtonStyle}" />

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                Command="{Binding CloseCommand}"
                                Content="{DynamicResource AnalysisDetail.ReportPreview.Close}"
                                Style="{StaticResource ReportSecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
