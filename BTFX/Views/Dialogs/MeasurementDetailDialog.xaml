<UserControl
    x:Class="BTFX.Views.Dialogs.MeasurementDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:vm="clr-namespace:BTFX.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:GaitAnalysisDetailViewModel}"
    Background="Transparent"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="OverlayMaskBrush" Color="#8C0D1B2A" />
        <SolidColorBrush x:Key="DialogBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#FAFAFA" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#EEF1F5" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#222222" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#666666" />
        <SolidColorBrush x:Key="WeakTextBrush" Color="#999999" />
        <SolidColorBrush x:Key="PrimaryPurpleBrush" Color="#40385F" />
        <SolidColorBrush x:Key="AccentOrangeBrush" Color="#FF8A00" />
        <SolidColorBrush x:Key="ExportBlueBrush" Color="#409EFF" />
        <Style BasedOn="{StaticResource DialogLightScrollBarStyle}" TargetType="ScrollBar" />

        <ControlTemplate x:Key="AnalysisPlotTrackerTemplate">
            <Border
                Padding="8,5"
                Background="#FFFFFF"
                BorderBrush="#DCE3EC"
                BorderThickness="1"
                CornerRadius="4">
                <TextBlock
                    FontFamily="{StaticResource AppFont}"
                    FontSize="12"
                    Foreground="#222222"
                    Text="{Binding Text}" />
            </Border>
        </ControlTemplate>

        <Style TargetType="{x:Type oxy:PlotView}">
            <Setter Property="DefaultTrackerTemplate" Value="{StaticResource AnalysisPlotTrackerTemplate}" />
        </Style>

        <Style x:Key="AnalysisPreviewSpeedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="62" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="OverridesDefaultStyle" Value="True" />
                        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border
                                        x:Name="ItemBorder"
                                        Padding="10,6"
                                        Background="Transparent"
                                        CornerRadius="4">
                                        <ContentPresenter
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#777777" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#7C7C7C" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="True">
                            <ToggleButton
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                ClickMode="Press"
                                Cursor="Hand"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="OuterBorder"
                                            Background="Transparent"
                                            CornerRadius="6">
                                            <Path
                                                Width="8"
                                                Height="5"
                                                Margin="0,0,4,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Data="M0,0 L4,4 L8,0"
                                                Fill="Transparent"
                                                Stroke="#FFFFFF"
                                                StrokeThickness="1.2" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter
                                Margin="0,0,18,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                IsHitTestVisible="False" />
                            <Popup
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Fade">
                                <Border
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,4,0,0"
                                    Padding="4"
                                    Background="#646464"
                                    BorderBrush="#777777"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InfoLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="InfoValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MetricLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>

        <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style
            x:Key="MetricCardStyle"
            BasedOn="{StaticResource SectionCardStyle}"
            TargetType="Border">
            <Setter Property="MinHeight" Value="90" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>

        <Style x:Key="TopTextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF6FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCEEFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterSecondaryActionStyle" TargetType="Button">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryPurpleBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="FooterPrimaryActionStyle"
            BasedOn="{StaticResource FooterSecondaryActionStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryPurpleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryPurpleBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="TabHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="196" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="LineHeight" Value="40" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>

        <Style x:Key="AnalysisTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            x:Name="TabPill"
                            Width="196"
                            Height="40"
                            Background="Transparent"
                            CornerRadius="22">
                            <Label
                                Width="196"
                                Height="40"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Content="{TemplateBinding Header}"
                                FontFamily="{StaticResource AppFont}"
                                FontSize="15"
                                FontWeight="Medium"
                                Foreground="{TemplateBinding Foreground}"
                                TextOptions.TextFormattingMode="Display" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabPill" Property="Background" Value="{StaticResource PrimaryPurpleBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabPill" Property="Background" Value="#E2E7F0" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabPill" Property="Background" Value="{StaticResource PrimaryPurpleBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnalysisTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource AnalysisTabItemStyle}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Width="600"
                                Height="48"
                                Padding="4"
                                HorizontalAlignment="Center"
                                Background="#EEF2F7"
                                CornerRadius="24">
                                <TabPanel
                                    x:Name="HeaderPanel"
                                    HorizontalAlignment="Center"
                                    IsItemsHost="True"
                                    KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                Grid.Row="1"
                                Margin="0,28,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                ContentSource="SelectedContent"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="DetailContentScrollViewerStyle"
            BasedOn="{StaticResource DialogLightweightScrollViewerStyle}"
            TargetType="ScrollViewer">
            <Setter Property="CanContentScroll" Value="False" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Border Background="{StaticResource OverlayMaskBrush}" />

        <Border
            Width="1380"
            Height="900"
            MaxWidth="1480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource DialogBgBrush}"
            BorderBrush="#E8EDF3"
            BorderThickness="1"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="28"
                    Direction="270"
                    Opacity="0.10"
                    ShadowDepth="0"
                    Color="#1F2A37" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="34,24,34,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Button
                            Command="{Binding ExportCommand}"
                            IsEnabled="{Binding CanExport}"
                            Style="{StaticResource TopTextButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource ExportBlueBrush}"
                                    Kind="Export" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource AppFont}"
                                    FontSize="14"
                                    Foreground="{StaticResource ExportBlueBrush}"
                                    Text="{DynamicResource AnalysisDetail.Export}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="26,0,0,0"
                            Command="{Binding OpenReportPreviewCommand}"
                            IsEnabled="{Binding CanConfigureReport}"
                            Style="{StaticResource TopTextButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource ExportBlueBrush}"
                                    Kind="FileDocumentOutline" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource AppFont}"
                                    FontSize="14"
                                    Foreground="{StaticResource ExportBlueBrush}"
                                    Text="{DynamicResource AnalysisDetail.ReportPreviewButton}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource TitleTextStyle}"
                        Text="{DynamicResource AnalysisDetail.Title}" />

                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource TopTextButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource AppFont}"
                                FontSize="14"
                                Foreground="{StaticResource WeakTextBrush}"
                                Text="{DynamicResource AnalysisDetail.Close}" />
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource WeakTextBrush}"
                                Kind="Close" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="34,28,34,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="4"
                                Height="18"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource AccentOrangeBrush}"
                                CornerRadius="2" />
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{DynamicResource AnalysisDetail.BasicInfo}" />
                        </StackPanel>
                        <WrapPanel Margin="0,18,0,0">
                            <TextBlock Style="{StaticResource InfoLabelTextStyle}" Text="{DynamicResource AnalysisDetail.Patient}" />
                            <TextBlock
                                Margin="8,0,52,0"
                                Style="{StaticResource InfoValueTextStyle}"
                                Text="{Binding PatientName, Mode=OneWay, TargetNullValue=--}" />
                            <TextBlock Style="{StaticResource InfoLabelTextStyle}" Text="{DynamicResource AnalysisDetail.Height}" />
                            <TextBlock
                                Margin="8,0,52,0"
                                Style="{StaticResource InfoValueTextStyle}"
                                Text="{Binding PatientHeightDisplay, Mode=OneWay, TargetNullValue=--}" />
                            <TextBlock Style="{StaticResource InfoLabelTextStyle}" Text="{DynamicResource AnalysisDetail.MeasurementType}" />
                            <TextBlock
                                Margin="8,0,52,0"
                                Style="{StaticResource InfoValueTextStyle}"
                                Text="{Binding MeasurementTypeDisplay, Mode=OneWay, TargetNullValue=--}" />
                            <TextBlock Style="{StaticResource InfoLabelTextStyle}" Text="{DynamicResource AnalysisDetail.AnalysisMode}" />
                            <TextBlock
                                Margin="8,0,52,0"
                                Style="{StaticResource InfoValueTextStyle}"
                                Text="{Binding MeasurementVideoModeDisplay, Mode=OneWay, TargetNullValue=--}" />
                            <TextBlock Style="{StaticResource InfoLabelTextStyle}" Text="{DynamicResource AnalysisDetail.MeasurementTime}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Style="{StaticResource InfoValueTextStyle}"
                                Text="{Binding MeasurementDate, Mode=OneWay, TargetNullValue=--}" />
                        </WrapPanel>
                    </StackPanel>

                    <TabControl
                        Grid.Row="2"
                        SelectionChanged="AnalysisTabControl_OnSelectionChanged"
                        Style="{StaticResource AnalysisTabControlStyle}">
                        <TabItem x:Name="OverviewTabItem" Header="{DynamicResource AnalysisDetail.Tab.Overview}">

                            <ScrollViewer Style="{StaticResource DetailContentScrollViewerStyle}" VerticalScrollBarVisibility="Disabled">
                                <DockPanel Width="1312" LastChildFill="False">
                                    <UniformGrid
                                        Margin="0,0,0,24"
                                        Columns="5"
                                        DockPanel.Dock="Top">
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{DynamicResource AnalysisDetail.GaitCycle}" />
                                                <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding GaitCycleDisplay, TargetNullValue=--}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{DynamicResource AnalysisDetail.AverageStepLength}" />
                                                <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding StepLengthDisplay, TargetNullValue=--}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{DynamicResource AnalysisDetail.AverageStrideLength}" />
                                                <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding StrideLengthDisplay, TargetNullValue=--}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{DynamicResource AnalysisDetail.AverageCadence}" />
                                                <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding CadenceDisplay, TargetNullValue=--}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0" Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="{DynamicResource AnalysisDetail.AverageGaitSpeed}" />
                                                <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding GaitSpeedDisplay, TargetNullValue=--}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Grid Margin="0,0,0,24" DockPanel.Dock="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54*" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="46*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                                <Border
                                                    Width="4"
                                                    Height="18"
                                                    Margin="0,0,10,0"
                                                    Background="{StaticResource AccentOrangeBrush}"
                                                    CornerRadius="2" />
                                                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{DynamicResource AnalysisDetail.ResultSummary}" />
                                            </StackPanel>
                                            <Border Height="220" Style="{StaticResource SectionCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="124" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock
                                                        Grid.Row="0"
                                                        Style="{StaticResource InfoLabelTextStyle}"
                                                        Text="{DynamicResource AnalysisDetail.ValidFrameRatio}" />
                                                    <TextBlock
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Style="{StaticResource InfoValueTextStyle}"
                                                        Text="{Binding ValidFrameRatioDisplay, TargetNullValue=--}" />
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Margin="0,14,0,0"
                                                        Style="{StaticResource InfoLabelTextStyle}"
                                                        Text="{DynamicResource AnalysisDetail.ResultPreviewNote}" />
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Margin="0,14,0,0"
                                                        Style="{StaticResource InfoValueTextStyle}"
                                                        Text="{DynamicResource AnalysisDetail.ResultPreviewNoteText}" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                                <Border
                                                    Width="4"
                                                    Height="18"
                                                    Margin="0,0,10,0"
                                                    Background="{StaticResource AccentOrangeBrush}"
                                                    CornerRadius="2" />
                                                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{DynamicResource AnalysisDetail.AnalysisBaseInfo}" />
                                            </StackPanel>
                                            <Border Height="220" Style="{StaticResource SectionCardStyle}">
                                                <Grid>
