                                                    Margin="0,0,0,12"
                                                    Padding="14"
                                                    Background="#FFFFFF"
                                                    BorderBrush="{StaticResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Visibility="{Binding IsDualVideoMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <oxy:PlotView Height="190" Model="{Binding PelvisAnglePlotModel}" />
                                                </Border>
                                                <Border
                                                    Padding="14"
                                                    Background="#FFFFFF"
                                                    BorderBrush="{StaticResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Visibility="{Binding IsDualVideoMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <oxy:PlotView Height="190" Model="{Binding TrunkAnglePlotModel}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="VideoPreviewTabItem" Header="{DynamicResource AnalysisDetail.Tab.Video}">

                            <ScrollViewer
                                x:Name="VideoPreviewDetailScrollViewer"
                                Loaded="VideoPreviewDetailScrollViewer_OnLoaded"
                                RequestBringIntoView="VideoPreviewDetailScrollViewer_OnRequestBringIntoView"
                                Style="{StaticResource DetailContentScrollViewerStyle}">
                                <DockPanel Width="1290" LastChildFill="False">
                                    <Border
                                        Margin="0,0,0,16"
                                        DockPanel.Dock="Top"
                                        Style="{StaticResource SectionCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="430" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="4"
                                                    Height="18"
                                                    Margin="0,0,10,0"
                                                    Background="{StaticResource AccentOrangeBrush}"
                                                    CornerRadius="2" />
                                                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{DynamicResource AnalysisDetail.VideoPreviewArea}" />
                                            </StackPanel>
                                            <Border
                                                Grid.Row="2"
                                                Background="#101820"
                                                CornerRadius="8">
                                                <Grid ClipToBounds="True">
                                                    <MediaElement
                                                        x:Name="AnalysisPreviewMediaElement"
                                                        LoadedBehavior="Manual"
                                                        MediaEnded="AnalysisPreviewMediaElement_OnMediaEnded"
                                                        MediaFailed="AnalysisPreviewMediaElement_OnMediaFailed"
                                                        MediaOpened="AnalysisPreviewMediaElement_OnMediaOpened"
                                                        Source="{Binding AnnotatedVideoUri}"
                                                        Stretch="Uniform"
                                                        UnloadedBehavior="Stop"
                                                        Visibility="{Binding HasAnnotatedVideo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasAnnotatedVideo, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                        <materialDesign:PackIcon
                                                            Width="70"
                                                            Height="70"
                                                            HorizontalAlignment="Center"
                                                            Foreground="#9AB0C7"
                                                            Kind="PlayCircleOutline" />
                                                        <TextBlock
                                                            Margin="0,14,0,0"
                                                            HorizontalAlignment="Center"
                                                            FontFamily="{StaticResource AppFont}"
                                                            FontSize="20"
                                                            FontWeight="SemiBold"
                                                            Foreground="White"
                                                            Text="{Binding AnnotatedVideoDisplay, TargetNullValue=--}" />
                                                        <TextBlock
                                                            Margin="0,8,0,0"
                                                            HorizontalAlignment="Center"
                                                            FontFamily="{StaticResource AppFont}"
                                                            FontSize="14"
                                                            Foreground="#D2DDE8"
                                                            Text="{Binding AnalysisPreviewStatusText}" />
                                                        <Border
                                                            Width="420"
                                                            Height="8"
                                                            Margin="0,20,0,0"
                                                            HorizontalAlignment="Center"
                                                            Background="#334A5D70"
                                                            CornerRadius="4"
                                                            Visibility="{Binding IsAnalysisPreviewGenerating, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ProgressBar
                                                                Height="8"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="#E4004A"
                                                                IsIndeterminate="True" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Button
                                                        x:Name="AnalysisPreviewOverlayPlayButton"
                                                        Width="96"
                                                        Height="96"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="#66000000"
                                                        BorderBrush="#99FFFFFF"
                                                        BorderThickness="1"
                                                        Click="AnalysisPreviewPlayButton_OnClick"
                                                        Cursor="Hand"
                                                        Padding="0"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        Visibility="Collapsed">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border
                                                                    x:Name="OverlayButtonBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="48">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="OverlayButtonBorder" Property="Background" Value="#88000000" />
                                                                        <Setter TargetName="OverlayButtonBorder" Property="BorderBrush" Value="#FFFFFFFF" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="OverlayButtonBorder" Property="Background" Value="#AA000000" />
                                                                        <Setter TargetName="OverlayButtonBorder" Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <materialDesign:PackIcon
                                                            Width="54"
                                                            Height="54"
                                                            Margin="6,0,0,0"
                                                            Foreground="White"
                                                            Kind="Play" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Margin="0,0,0,16"
                                        DockPanel.Dock="Top"
                                        Style="{StaticResource SectionCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.ColumnSpan="4"
                                                Height="56"
                                                Background="#646464"
                                                CornerRadius="8" />
                                            <Button
                                                Grid.Column="0"
                                                Width="28"
                                                Height="28"
                                                Margin="10,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Click="AnalysisPreviewPlayButton_OnClick"
                                                Cursor="Hand"
                                                Foreground="White"
                                                Padding="0"
                                                Style="{StaticResource MaterialDesignIconButton}">
                                                <materialDesign:PackIcon
                                                    x:Name="AnalysisPreviewPlayIcon"
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Kind="Play" />
                                            </Button>
                                            <StackPanel
                                                Grid.Column="1"
                                                Width="70"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Name="AnalysisPreviewCurrentTimeText"
                                                    FontFamily="{StaticResource AppFont}"
                                                    FontSize="12"
                                                    Foreground="White"
                                                    Text="0:00"
                                                    TextAlignment="Center" />
                                                <TextBlock
                                                    x:Name="AnalysisPreviewDurationText"
                                                    Margin="0"
                                                    FontFamily="{StaticResource AppFont}"
                                                    FontSize="12"
                                                    Foreground="#EAEAEA"
                                                    Text="{Binding VideoDurationPlaybackDisplay}"
                                                    TextAlignment="Center"
                                                    Visibility="Collapsed" />
                                            </StackPanel>
                                            <Slider
                                                x:Name="AnalysisPreviewProgressSlider"
                                                Grid.Column="2"
                                                Margin="0,0,0,0"
                                                VerticalAlignment="Center"
                                                PreviewMouseDown="AnalysisPreviewProgressSlider_OnPreviewMouseDown"
                                                PreviewMouseUp="AnalysisPreviewProgressSlider_OnPreviewMouseUp"
                                                ValueChanged="AnalysisPreviewProgressSlider_OnValueChanged"
                                                Maximum="1"
                                                Minimum="0"
                                                Value="0" />
                                            <ComboBox
                                                x:Name="AnalysisPreviewSpeedComboBox"
                                                Grid.Column="3"
                                                Margin="0,0,8,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                PreviewMouseWheel="AnalysisPreviewSpeedComboBox_OnPreviewMouseWheel"
                                                SelectedIndex="3"
                                                SelectionChanged="AnalysisPreviewSpeedComboBox_OnSelectionChanged"
                                                Style="{StaticResource AnalysisPreviewSpeedComboBoxStyle}">
                                                <ComboBoxItem Content="0.1x" Tag="0.1" />
                                                <ComboBoxItem Content="0.25x" Tag="0.25" />
                                                <ComboBoxItem Content="0.5x" Tag="0.5" />
                                                <ComboBoxItem Content="1x" Tag="1" />
                                                <ComboBoxItem Content="1.5x" Tag="1.5" />
                                                <ComboBoxItem Content="2x" Tag="2" />
                                                <ComboBoxItem Content="4x" Tag="4" />
                                                <ComboBoxItem Content="8x" Tag="8" />
                                                <ComboBoxItem Content="10x" Tag="10" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <StackPanel DockPanel.Dock="Top">
                                        <Border Margin="0,0,0,14" Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Border Width="26" Height="4" Margin="0,0,6,0" VerticalAlignment="Center" Background="ForestGreen" CornerRadius="2" />
                                                    <TextBlock Margin="0,0,18,0" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="#666666" Text="{DynamicResource AnalysisDetail.LeftKnee}" />
                                                    <Border Width="26" Height="4" Margin="0,0,6,0" VerticalAlignment="Center" Background="#F2306A" CornerRadius="2" />
                                                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="#666666" Text="{DynamicResource AnalysisDetail.RightKnee}" />
                                                </StackPanel>
                                                <oxy:PlotView Height="220" Model="{Binding VideoKneeAnglePlotModel}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,0,14" Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Border Width="26" Height="4" Margin="0,0,6,0" VerticalAlignment="Center" Background="SteelBlue" CornerRadius="2" />
                                                    <TextBlock Margin="0,0,18,0" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="#666666" Text="{DynamicResource AnalysisDetail.LeftHip}" />
                                                    <Border Width="26" Height="4" Margin="0,0,6,0" VerticalAlignment="Center" Background="OrangeRed" CornerRadius="2" />
                                                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="#666666" Text="{DynamicResource AnalysisDetail.RightHip}" />
                                                </StackPanel>
                                                <oxy:PlotView Height="210" Model="{Binding VideoHipAnglePlotModel}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,0,14" Style="{StaticResource SectionCardStyle}">
                                            <StackPanel>
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Border Width="26" Height="4" Margin="0,0,6,0" VerticalAlignment="Center" Background="MediumPurple" CornerRadius="2" />
                                                    <TextBlock Margin="0,0,18,0" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="#666666" Text="{DynamicResource AnalysisDetail.LeftAnkle}" />
                                                    <Border Width="26" Height="4" Margin="0,0,6,0" VerticalAlignment="Center" Background="DarkCyan" CornerRadius="2" />
                                                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="#666666" Text="{DynamicResource AnalysisDetail.RightAnkle}" />
                                                </StackPanel>
                                                <oxy:PlotView Height="210" Model="{Binding VideoAnkleAnglePlotModel}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,0,14" Style="{StaticResource SectionCardStyle}" Visibility="{Binding IsDualVideoMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Border Width="26" Height="4" Margin="0,0,6,0" VerticalAlignment="Center" Background="#40385F" CornerRadius="2" />
                                                    <TextBlock Margin="0,0,18,0" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="#666666" Text="{DynamicResource AnalysisDetail.Pelvis}" />
                                                </StackPanel>
                                                <oxy:PlotView Height="210" Model="{Binding VideoPelvisAnglePlotModel}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,0,14" Style="{StaticResource SectionCardStyle}" Visibility="{Binding IsDualVideoMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Border Width="26" Height="4" Margin="0,0,6,0" VerticalAlignment="Center" Background="#F2306A" CornerRadius="2" />
                                                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="#666666" Text="{DynamicResource AnalysisDetail.Trunk}" />
                                                </StackPanel>
                                                <oxy:PlotView Height="210" Model="{Binding VideoTrunkAnglePlotModel}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Border>
        <Border
            Background="#CCFFFFFF"
            CornerRadius="8"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar
                    Width="220"
                    Height="8"
                    IsIndeterminate="True"
                    Foreground="{StaticResource PrimaryPurpleBrush}" />
                <TextBlock
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource AppFont}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="{DynamicResource AnalysisDetail.Loading}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
