<UserControl
    x:Class="BTFX.Views.Dialogs.PasswordResetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:BTFX.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:BTFX.ViewModels"
    Width="580"
    Height="520"
    d:DataContext="{d:DesignInstance Type=vm:PasswordResetDialogViewModel}"
    d:DesignHeight="620"
    d:DesignWidth="760"
    FontFamily="{StaticResource AppFont}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ResetDialogLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="132" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="ResetPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Width" Value="360" />
            <Setter Property="Height" Value="72" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E1E1E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResetPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Background" Value="#403B5B" />
            <Setter Property="BorderBrush" Value="#403B5B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border
        Background="#FFFFFF"
        CornerRadius="8"
        SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="88" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#F3F8FC"
                CornerRadius="8,8,0,0">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Medium"
                        Foreground="#333333"
                        Text="{Binding Title}" />

                    <Button
                        Width="56"
                        Height="56"
                        Margin="0,0,24,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CancelCommand}"
                        Cursor="Hand">
                        <materialDesign:PackIcon
                            Width="28"
                            Height="28"
                            Foreground="#403B5B"
                            Kind="Close" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,50,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="90" />
                    <RowDefinition Height="90" />
                    <RowDefinition Height="82" />
                    <RowDefinition Height="92" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="540" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ResetDialogLabelStyle}">
                        <Run Foreground="#F23030" Text="* " />
                        <Run Text="登录密码" />
                    </TextBlock>
                    <PasswordBox
                        MaxLength="20"
                      Margin="16,0,0,0"
                        PasswordChanged="PasswordBox_OnPasswordChanged"
                        Style="{StaticResource ResetPasswordBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ResetDialogLabelStyle}">
                        <Run Foreground="#F23030" Text="* " />
                        <Run Text="确认密码" />
                    </TextBlock>
                    <PasswordBox
                        MaxLength="20"
                      Margin="16,0,0,0"
                        PasswordChanged="ConfirmPasswordBox_OnPasswordChanged"
                        Style="{StaticResource ResetPasswordBoxStyle}" />
                </StackPanel>

                <Grid Grid.Row="2" Grid.Column="1">
                    <TextBlock
                        Margin="156,0,0,0"
                        VerticalAlignment="Top"
                        FontSize="18"
                        Foreground="#999999"
                        LineHeight="30"
                        Text="密码由纯数字组成，&#x0a;登录密码需与确认密码一致。" />

                    <TextBlock
                        Margin="156,60,0,0"
                        VerticalAlignment="Top"
                        FontSize="20"
                        FontWeight="Medium"
                        Foreground="#F23030"
                        Text="{Binding ValidationError}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <Button
                    Grid.Row="3"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Command="{Binding ConfirmCommand}"
                    Content="确认"
                    Style="{StaticResource ResetPrimaryButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
