<UserControl
    x:Class="BTFX.Views.ActivationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    Background="#F4F4F4"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ActivationLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ActivationValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#403B5B" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ActivationInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#D8D8D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#403B5B" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="0"
                                VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Background" Value="#403B5B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#403B5B" />
            <Setter Property="BorderBrush" Value="#403B5B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F7F6FB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border
            Width="980"
            Padding="48,40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#FFFFFF"
            CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource AppFont}"
                        FontSize="32"
                        FontWeight="Medium"
                        Foreground="#403B5B"
                        Text="软件激活" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource AppFont}"
                        FontSize="16"
                        Foreground="#999999"
                        Text="请完成软件授权激活后继续使用系统" />
                </StackPanel>

                <Border
                    Grid.Row="2"
                    Padding="28,22"
                    Background="#FAFAFA"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="44" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ActivationLabelStyle}" Text="软件名称" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ActivationValueStyle}" Text="{Binding EquipmentName}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ActivationLabelStyle}" Text="产品型号" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource ActivationValueStyle}" Text="{Binding EquipmentModel}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ActivationLabelStyle}" Text="软件版本" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ActivationValueStyle}" Text="{Binding EquipmentVersion}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ActivationLabelStyle}" Text="MAC地址" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource ActivationValueStyle}" Text="{Binding MacAddress}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ActivationLabelStyle}" Text="CPU编号" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ActivationValueStyle}" Text="{Binding CpuId}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ActivationLabelStyle}" Text="硬盘信息" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource ActivationValueStyle}" Text="{Binding DiskId}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ActivationLabelStyle}" Text="BIOS编号" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ActivationValueStyle}" Text="{Binding BiosId}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ActivationLabelStyle}" Text="机器码" />
                        <DockPanel Grid.Row="3" Grid.Column="3">
                            <Button
                                Width="88"
                                Height="32"
                                Margin="12,0,0,0"
                                Command="{Binding CopyMachineCodeCommand}"
                                DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryActionButtonStyle}">
                                <TextBlock
                                    FontFamily="{StaticResource AppFont}"
                                    FontSize="14"
                                    Foreground="#403B5B"
                                    Text="复制" />
                            </Button>
                            <TextBlock Style="{StaticResource ActivationValueStyle}" Text="{Binding MachineCode}" />
                        </DockPanel>
                        <Button
                            Grid.Row="4"
                            Grid.Column="3"
                            Width="132"
                            Height="32"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding CopyDeviceInfoCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}">
                            <TextBlock
                                FontFamily="{StaticResource AppFont}"
                                FontSize="14"
                                Foreground="#403B5B"
                                Text="复制设备信息" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ActivationLabelStyle}" Text="产品编号" />
                    <TextBox
                        Grid.Column="1"
                        Style="{StaticResource ActivationInputStyle}"
                        Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource ActivationLabelStyle}" Text="激活码" />
                    <TextBox
                        Grid.Column="4"
                        Style="{StaticResource ActivationInputStyle}"
                        Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <StackPanel Grid.Row="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource AppFont}"
                        FontSize="16"
                        Foreground="#999999"
                        Text="{Binding Message}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,28,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Width="160"
                            Height="52"
                            Command="{Binding ActivateOnlineCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}">
                            <TextBlock
                                FontFamily="{StaticResource AppFont}"
                                FontSize="18"
                                Foreground="White"
                                Text="在线激活" />
                        </Button>
                        <Button
                            Width="160"
                            Height="52"
                            Margin="28,0,0,0"
                            Command="{Binding ActivateOfflineCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}">
                            <TextBlock
                                FontFamily="{StaticResource AppFont}"
                                FontSize="18"
                                Foreground="#403B5B"
                                Text="离线激活" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
