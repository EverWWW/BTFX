<Window
    x:Class="ActivationCodeTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="离线激活码生成工具"
    Width="760"
    Height="750"
    MinWidth="720"
    MinHeight="750"
    Background="#F5F6FA"
    WindowStartupLocation="CenterScreen">
    <Border
        Margin="18"
        Background="#FFFFFF"
        BorderBrush="#E8EDF3"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="78" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#F3F8FC"
                CornerRadius="8,8,0,0">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="#2F2A4A"
                        Text="离线激活码生成工具" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="34,26,34,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,18"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="请从目标电脑的激活页面复制设备信息，填入下方字段后生成离线激活码。" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="软件名称" />
                <TextBox
                    x:Name="EquipmentNameTextBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="步态智能分析系统" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,14,0,0"
                    Text="产品型号" />
                <TextBox
                    x:Name="EquipmentModelTextBox"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,14,0,0"
                    Text="XY-K-BTFX-I" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,14,0,0"
                    Text="BIOS编号" />
                <TextBox
                    x:Name="BiosIdTextBox"
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,14,0,0" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="0,14,0,0"
                    Text="CPU编号" />
                <TextBox
                    x:Name="CpuIdTextBox"
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="0,14,0,0" />

                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="0,14,0,0"
                    Text="硬盘信息" />
                <TextBox
                    x:Name="DiskIdTextBox"
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="0,14,0,0" />

                <Grid
                    Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="机器码" />
                    <TextBox
                        x:Name="MachineCodeTextBox"
                        Grid.Row="0"
                        Grid.Column="1" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,14,0,0"
                        Text="激活码" />
                    <TextBox
                        x:Name="LicenseKeyTextBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,14,0,0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#403B5B"
                        IsReadOnly="True" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="生成规则与主程序离线激活校验保持一致：BIOS、CPU、产品型号、软件名称、硬盘信息、机器码共同参与计算。"
                        TextWrapping="Wrap" />
                </Grid>
            </Grid>

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Click="ClearButton_OnClick"
                    Content="清空"
                    Style="{StaticResource SecondaryButtonStyle}" />
                <Button
                    Margin="18,0,0,0"
                    Click="PasteDeviceInfoButton_OnClick"
                    Content="粘贴设备信息"
                    Style="{StaticResource SecondaryButtonStyle}" />
                <Button
                    Margin="18,0,0,0"
                    Click="GenerateButton_OnClick"
                    Content="生成激活码"
                    Style="{StaticResource PrimaryButtonStyle}" />
                <Button
                    Margin="18,0,0,0"
                    Click="CopyButton_OnClick"
                    Content="复制激活码"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
