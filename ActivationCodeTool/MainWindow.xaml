<Window x:Class="ActivationCodeTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="离线激活码生成工具"
        Width="760"
        Height="620"
        MinWidth="720"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">
    <Border Margin="18"
            Background="#FFFFFF"
            BorderBrush="#E8EDF3"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="78" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#F3F8FC"
                    CornerRadius="8,8,0,0">
                <Grid>
                    <TextBlock Text="离线激活码生成工具"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#2F2A4A" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="34,26,34,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Margin="0,0,0,18"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="请从目标电脑的激活页面复制设备信息，填入下方字段后生成离线激活码。" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="软件名称" />
                <TextBox x:Name="EquipmentNameTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Text="步态智能分析系统" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="产品型号" Margin="0,14,0,0" />
                <TextBox x:Name="EquipmentModelTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Margin="0,14,0,0"
                         Text="XY-K-BTFX-I" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="BIOS编号" Margin="0,14,0,0" />
                <TextBox x:Name="BiosIdTextBox"
                         Grid.Row="3"
                         Grid.Column="1"
                         Margin="0,14,0,0" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="CPU编号" Margin="0,14,0,0" />
                <TextBox x:Name="CpuIdTextBox"
                         Grid.Row="4"
                         Grid.Column="1"
                         Margin="0,14,0,0" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="硬盘信息" Margin="0,14,0,0" />
                <TextBox x:Name="DiskIdTextBox"
                         Grid.Row="5"
                         Grid.Column="1"
                         Margin="0,14,0,0" />

                <Grid Grid.Row="6" Grid.ColumnSpan="2" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="机器码" />
                    <TextBox x:Name="MachineCodeTextBox"
                             Grid.Row="0"
                             Grid.Column="1" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="激活码" Margin="0,14,0,0" />
                    <TextBox x:Name="LicenseKeyTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="0,14,0,0"
                             IsReadOnly="True"
                             FontSize="16"
                             FontWeight="SemiBold"
                             Foreground="#403B5B" />

                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="生成规则与主程序离线激活校验保持一致：BIOS、CPU、产品型号、软件名称、硬盘信息、机器码共同参与计算。" />
                </Grid>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button Content="清空"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ClearButton_OnClick" />
                <Button Content="粘贴设备信息"
                        Margin="18,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="PasteDeviceInfoButton_OnClick" />
                <Button Content="生成激活码"
                        Margin="18,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="GenerateButton_OnClick" />
                <Button Content="复制激活码"
                        Margin="18,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CopyButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
